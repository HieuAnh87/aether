{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Aether default capability set",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-tooltip",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
