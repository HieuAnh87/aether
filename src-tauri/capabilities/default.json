{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Aether default capability set",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-tooltip",
    "dialog:default",
    "keyring:default",
    "updater:default",
    "process:default"
  ]
}
